generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// --- Auth.js models (standard shape for @auth/prisma-adapter) ---

model User {
  id            String       @id @default(cuid())
  name          String?
  email         String?      @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  ownedTrips    Trip[]       @relation("TripOwner")
  memberships   TripMember[]
  sentInvites   TripInvite[] @relation("InvitedBy")
  createdItems  Attraction[] @relation("ItemCreatedBy")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// --- App models ---

enum TripRole {
  OWNER
  EDITOR
  VIEWER
}

enum InviteStatus {
  PENDING
  ACCEPTED
  REVOKED
}

enum Category {
  FOOD
  SIGHTSEEING
  SHOPPING
  TRANSPORT
  LODGING
  OTHER
}

model Trip {
  id            String       @id @default(cuid())
  name          String
  startDate     DateTime     @db.Date
  endDate       DateTime     @db.Date
  coverImageUrl String?
  ownerId       String
  owner         User         @relation("TripOwner", fields: [ownerId], references: [id])
  members       TripMember[]
  invites       TripInvite[]
  attractions   Attraction[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model TripMember {
  id        String   @id @default(cuid())
  tripId    String
  userId    String
  role      TripRole
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([tripId, userId])
}

model TripInvite {
  id          String       @id @default(cuid())
  tripId      String
  email       String
  role        TripRole
  status      InviteStatus @default(PENDING)
  invitedById String
  trip        Trip         @relation(fields: [tripId], references: [id], onDelete: Cascade)
  invitedBy   User         @relation("InvitedBy", fields: [invitedById], references: [id])
  createdAt   DateTime     @default(now())
  resolvedAt  DateTime?

  @@unique([tripId, email])
}

model Attraction {
  id          String   @id @default(cuid())
  tripId      String
  trip        Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  name        String
  category    Category
  dayIndex    Int?
  position    Int
  time        String?
  lat         Float?
  lng         Float?
  address     String?
  notes       String?
  photoUrl    String?
  createdById String
  createdBy   User     @relation("ItemCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tripId, dayIndex, position])
}
